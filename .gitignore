# Data is public and large — download it, don't commit it
data/raw/**
!data/raw/**/.gitkeep
data/processed/**
!data/processed/.gitkeep

# Charts and tables are re-created by `make all` - don't commit them
outputs/**
!outputs/*/
!outputs/**/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/